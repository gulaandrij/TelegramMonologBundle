{
  "name": "gulaandrij/telegram-monolog",
  "license": "MIT",
  "description": "",
  "type": "symfony-bundle",
  "autoload": {
    "psr-4": {
      "TelegramMonolog\\Bundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TelegramMonolog\\Bundle\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "symfony/framework-bundle": "^7.0 || ^8.0",
    "symfony/http-client": "^7.0 || ^8.0",
    "symfony/yaml": "^7.0 || ^8.0",
    "monolog/monolog": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.50",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0",
    "symfony/var-dumper": "^7.0 || ^8.0"
  },
  "scripts": {
    "cs-check": "php-cs-fixer fix --dry-run --diff",
    "cs-fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse",
    "test": "phpunit"
  }
}
