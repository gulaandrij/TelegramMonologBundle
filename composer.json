{
  "name": "gulaandrij/telegram-monolog",
  "license": "MIT",
  "description": "",
  "type": "symfony-bundle",
  "autoload": {
    "psr-4": {
      "TelegramMonolog\\Bundle\\": "src/"
    }
  },
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-json": "*",
    "symfony/framework-bundle": "^7.0 || ^8.0",
    "monolog/monolog": "^3.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "symfony/var-dumper": "^7.0 || ^8.0"
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"file_exists('phpcs.xml') || copy('phpcs.xml.dist', 'phpcs.xml');\""
    ]
  }
}
